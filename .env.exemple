# Template for local development — copy to .env.local (ENV defaults to "local").
# The real settings contract lives in core/config.py.

# ── Core ──
ENV=local

# ── CRM database ──
# The delivery tables live in the CRM schema, owned by crm-backend. This service
# owns no database of its own, so there is no LOCAL_DATABASE_URL.
#
# It connects as `notification_dispatch_svc`, whose ONLY privileges in crm_db are
# SELECT everywhere, UPDATE on outbound_message (which is also what
# `SELECT ... FOR UPDATE SKIP LOCKED` needs) and INSERT on email_suppression.
# Inside the dev stack the host is the compose service name, `postgres`; from the
# host machine it is localhost:8080. The role and its grants are provisioned by
# the monorepo (https://github.com/OptimCE/monorepo), under postgres/.
CRM_DATABASE_URL=postgresql+asyncpg://notification_dispatch_svc:postgres@localhost:8080/crm_db
CRM_DB_POOL_SIZE=5
CRM_DB_MAX_OVERFLOW=5
CRM_DB_POOL_RECYCLE=3600
CRM_DB_POOL_TIMEOUT=30
CRM_DB_SSL=false

# ── Email transport ──
# SMTP | BREVO | NOOP. NOOP is refused outside local/test: it marks everything
# SENT while no mail leaves, which no dashboard would ever show.
EMAIL_TRANSPORT=SMTP
EMAIL_FROM_ADDRESS=no-reply@optimce.be
EMAIL_FROM_NAME=OptimCE
EMAIL_REPLY_TO=contact@optimce.be
EMAIL_MESSAGE_ID_DOMAIN=optimce.be
APP_URL=http://localhost

# ── SMTP (Mailpit in the dev stack) ──
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_STARTTLS=false
SMTP_TLS=false
SMTP_TIMEOUT_SECONDS=15

# ── Brevo ──
BREVO_API_KEY=
BREVO_BASE_URL=https://api.brevo.com
BREVO_TIMEOUT_SECONDS=10
# Brevo reports bounces by webhook only and this service has no inbound HTTP
# surface, so suppression is kept current by polling its blocked-contact list.
BREVO_SUPPRESSION_SYNC_INTERVAL_SECONDS=3600

# ── Dispatch loop ──
DISPATCH_POLL_INTERVAL_SECONDS=15
DISPATCH_BATCH_SIZE=20
DISPATCH_MAX_ATTEMPTS=5
DISPATCH_BACKOFF_BASE_SECONDS=60
DISPATCH_CLAIM_STALE_SECONDS=300

# ── Localisation ──
DEFAULT_LOCALE=fr

# ── Observability ──
LOGGING_TOKEN=
LOGGING_TRACES_URL=
LOGGING_LOGS_URL=
LOGGING_METRICS_URL=
