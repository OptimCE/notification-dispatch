# Loaded by core/config.py when ENV=test is exported (e.g. by tests/conftest.py).
# The CRM test schema is applied to a single Postgres on 5433 by the test
# fixtures; the transport is a hand-rolled fake injected per test.

# ── Core ──
ENV=test

# ── CRM database ──
CRM_DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5433/test_db_be
CRM_DB_POOL_SIZE=5
CRM_DB_MAX_OVERFLOW=2
CRM_DB_POOL_RECYCLE=3600
CRM_DB_POOL_TIMEOUT=10
CRM_DB_SSL=false

# ── Email transport ──
# NOOP so nothing constructed at import can fail; tests inject their own
# recording transport into dispatch_once.
EMAIL_TRANSPORT=NOOP
EMAIL_FROM_ADDRESS=no-reply@test.optimce.be
EMAIL_FROM_NAME=OptimCE
EMAIL_REPLY_TO=
EMAIL_MESSAGE_ID_DOMAIN=test.optimce.be
APP_URL=http://localhost

# ── SMTP ──
SMTP_HOST=
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_STARTTLS=false
SMTP_TLS=false
SMTP_TIMEOUT_SECONDS=5

# ── Brevo ──
BREVO_API_KEY=
BREVO_BASE_URL=https://api.brevo.invalid
BREVO_TIMEOUT_SECONDS=5
BREVO_SUPPRESSION_SYNC_INTERVAL_SECONDS=0

# ── Dispatch loop ──
DISPATCH_POLL_INTERVAL_SECONDS=1
DISPATCH_BATCH_SIZE=20
DISPATCH_MAX_ATTEMPTS=3
DISPATCH_BACKOFF_BASE_SECONDS=60
DISPATCH_CLAIM_STALE_SECONDS=300

# ── Localisation ──
DEFAULT_LOCALE=fr

# ── Observability ──
LOGGING_TOKEN=
LOGGING_TRACES_URL=
LOGGING_LOGS_URL=
LOGGING_METRICS_URL=
